# ==========================================
# 🍃 Leafy Project Environment Variables Example
# 이 파일은 '복사'하여 .env 로 이름을 변경한 뒤,
# 실제 값을 채워넣고 사용하세요.
# ==========================================

# --------------------------
# 1. Database (PostgreSQL)
# --------------------------
DATASOURCE_USERNAME=myuser
DATASOURCE_PASSWORD=changeme
DATASOURCE_DB_NAME=leafy_db
# DB 관리자(root/postgres) 비밀번호 (초기 셋업 시 필요)
DATASOURCE_ADMIN_PASSWORD=admin_changeme

# --------------------------
# 2. Redis Configuration
# --------------------------
# Docker Compose 서비스명 (로컬: redis, 배포환경: redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_changeme

# --------------------------
# 3. Security (JWT)
# --------------------------
# HS256 알고리즘을 위한 32글자 이상의 시크릿 키
JWT_SECRET=input_your_very_long_secret_key_here

# --------------------------
# 4. External Integrations (Discord)
# --------------------------
# 서버 에러 발생 시 알림을 보낼 웹훅 URL
DISCORD_500_WEBHOOK_URI=https://discord.com/api/webhooks/...
DISCORD_400_WEBHOOK_URI=https://discord.com/api/webhooks/...




