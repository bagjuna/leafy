+
+    private String getClientIp(HttpServletRequest request) {
+        String clientIp = request.getHeader("X-Forwarded-For");
+        if (clientIp != null && !clientIp.isBlank()) {
+            return clientIp.split(",")[0].trim();
+        }
+        return request.getRemoteAddr();
